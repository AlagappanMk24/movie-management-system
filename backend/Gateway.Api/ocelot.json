        {
          "Host": "localhost",
          "Port": 7293
        }
      ],
      "SwaggerKey": "TheatreMasterService",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },
    {
      // Public screen catalog and details endpoints (No JWT required)
      "UpstreamPathTemplate": "/api/screen/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/screen/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7293
        }
      ],
      "SwaggerKey": "TheatreMasterService"
    },
    {
      // Admin-only screen management mutations (JWT required)
      "UpstreamPathTemplate": "/api/screen/{everything}",
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/screen/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7293
        }
      ],
      "SwaggerKey": "TheatreMasterService",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },
    {
      // Public show schedules, movie shows, and seat availability endpoints (No JWT required)
      "UpstreamPathTemplate": "/api/show/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/show/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7293
        }
      ],
      "SwaggerKey": "TheatreMasterService"
    },
    {
      // Admin-only show schedule management mutations (JWT required)
      "UpstreamPathTemplate": "/api/show/{everything}",
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/show/{everything}",
