          "Url": "https://localhost:7277/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "Userservice",
      "Config": [
        {
          "Name": "User Service API",
          "Version": "v1",
          "Url": "https://localhost:7195/swagger/v1/swagger.json"
