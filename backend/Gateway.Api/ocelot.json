{
  "Routes": [
    // ==========================================
    // 1. USER & AUTHENTICATION SERVICE ROUTES
    // ==========================================
    {
      "UpstreamPathTemplate": "/api/user",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/api/user",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7195
        }
      ],
      "SwaggerKey": "Userservice",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },
    {
      "UpstreamPathTemplate": "/api/user/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/user/{id}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7195
        }
      ],
      "SwaggerKey": "Userservice"
    },
    {
      "UpstreamPathTemplate": "/api/user/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/user/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7195
        }
      ],
      "SwaggerKey": "Userservice",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },
    {
      // Public Authentication login/register endpoints (No JWT required)
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [ "Post" ],
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7195
        }
      ],
      "SwaggerKey": "Userservice"
    },

    // ==========================================
    // 2. BOOKING SERVICE ROUTES
    // ==========================================
    {
      // All bookings list (Admin role enforced in BookingController)
      "UpstreamPathTemplate": "/api/booking",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/booking",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7277
        }
      ],
      "SwaggerKey": "Bookingservice",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },
    {
      // Movie-wise collection analytics
      "UpstreamPathTemplate": "/api/booking/movie-collection",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/booking/movie-collection",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7277
        }
      ],
      "SwaggerKey": "Bookingservice",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },
    {
      // Booking queries, seat lookups, ticket PDF/QR downloads,
      // booking creation (standard / with seats / bulk TVP / Excel upload),
      // and booking cancellation / status updates
      "UpstreamPathTemplate": "/api/booking/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/booking/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7277
        }
      ],
      "SwaggerKey": "Bookingservice",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },

    // ==========================================
    // 3. MOVIE & MEDIA SERVICE ROUTES
    // ==========================================
    {
      // Public movie catalog, details, and poster endpoints (No JWT required)
      "UpstreamPathTemplate": "/api/movies/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/movies/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7238
        }
      ],
      "SwaggerKey": "Movieservice"
    },
    {
      // Admin-only movie management mutations (JWT required)
      "UpstreamPathTemplate": "/api/movies/{everything}",
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "DownstreamPathTemplate": "/api/movies/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7238
        }
      ],
      "SwaggerKey": "Movieservice",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "IdentityServiceKey"
      }
    },
    {
      // Public static poster image file assets
      "UpstreamPathTemplate": "/posters/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/posters/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7238
        }
      ],
      "SwaggerKey": "Movieservice"
    },

