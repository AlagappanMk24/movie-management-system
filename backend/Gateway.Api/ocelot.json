  "SwaggerEndPoints": [
    {
      "Key": "TheatreMasterService",
      "Config": [
        {
          "Name": "TheatreMaster Service API",
          "Version": "v1",
          "Url": "https://localhost:7293/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "Bookingservice",
      "Config": [
        {
          "Name": "Booking Service API",
